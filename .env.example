# Next.js web app. Set this to the separately deployed Python API URL.
INTELLIGENCE_API_URL=https://your-intelligence-api.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase production persistence, graph tables, storage and pgvector RAG.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DeepSeek powers extraction, chat/tool reasoning, email drafts and reports.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# KeiroLabs powers web/source discovery and LinkedIn-link lookup.
KEIROLABS_API_KEY=keirolabs_...
KEIROLABS_BASE_URL=https://kierolabs.space
# Discovery reuses extracted search content and requires all three live providers.
KEIROLABS_SEARCH_RESULTS=5
KEIROLABS_FETCHES_PER_QUERY=1
KEIROLABS_MAX_REQUESTS_PER_JOB=12

# Local BGE embeddings. The Supabase graph migration uses vector(384).
BGE_MODEL=BAAI/bge-small-en-v1.5
BGE_VECTOR_DIMENSIONS=384

# Optional legacy Anthropic support for the existing Next.js fallback routes.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
