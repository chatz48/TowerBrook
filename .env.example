# Enables the AI features (call-prep, outreach, "Ask the pool") and the live
# discovery agent. Without it the app still runs — those features fall back to
# transparent templates / keyword search.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for generation (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase production persistence, graph tables and pgvector RAG.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Embeddings for pgvector retrieval. The schema uses vector(1536), matching
# text-embedding-3-small unless you also change the migration.
OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
