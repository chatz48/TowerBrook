{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,**/__pycache__/**,**/*.test.py,fixtures/**,__fixtures__/**,testdata/**,.pytest_cache/**}"
    }
  },
  "crons": [
    {
      "path": "/jobs/process-next",
      "schedule": "*/15 * * * *"
    }
  ]
}
